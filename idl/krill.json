      "value": "32"
    },
    {
      "name": "MAX_TITLE_LEN",
      "docs": [
        "Titles are stored inline in the proposal; 64 bytes fits a headline."
      ],
      "type": "u8",
      "value": "64"
    },
    {
      "name": "MEMBER_SEED",
      "type": "bytes",
      "value": "[109, 101, 109, 98, 101, 114]"
    },
