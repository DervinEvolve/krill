{
  "name": "krill-arena",
  "private": true,
  "type": "module",
  "author": "DervinEvolve",
  "license": "MIT",
  "workspaces": [
    "arena",
    "app",
    "cli"
  ],
  "scripts": {
    "arena": "npm run start -w arena --",
    "app": "npm run dev -w app",
    "krill": "node cli/bin/krill.mjs",
    "idl:sync": "cp target/idl/krill.json idl/krill.json && cp target/types/krill.ts idl/krill.ts",
    "typecheck": "npm run typecheck --workspaces",
    "capture": "node scripts/capture-arena.mjs",
    "capture:figures": "node scripts/capture-figures.mjs",
    "record": "node scripts/record-run.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
